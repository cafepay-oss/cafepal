FROM python:3.7.17-bullseye
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN python -m pip install --no-cache-dir pip==23.3.2 setuptools==57.5.0 wheel==0.41.3
COPY deploy/local/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY cafepal ./cafepal
COPY cafepay ./cafepay
COPY sms ./sms
COPY local_static ./local_static
COPY manage.py ./
COPY deploy/local/runtime_config.py ./cafepal/secret.py
COPY deploy/local/start.sh /usr/local/bin/cafepay-start
RUN chmod +x /usr/local/bin/cafepay-start
CMD ["cafepay-start"]
