FROM node:14.21.3-bullseye AS build
WORKDIR /app
RUN npm install -g npm@8.19.4
ARG SOURCE_DIR
COPY ${SOURCE_DIR}/package*.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY ${SOURCE_DIR}/ ./
ARG API_ORIGIN=http://localhost:8000
ARG SOCKET_ORIGIN=ws://localhost:8000/
ARG BUILD_SCRIPT=build
ENV CAFEPAY_WEBAPP_BASE_URL=${API_ORIGIN}/api/
ENV CAFEPAY_WEBAPP_SOCKET_URL=${SOCKET_ORIGIN}
ENV CAFEPAY_WEBAPP_MEDIA_URL=${API_ORIGIN}/
ENV CAFEPAY_WEBAPP_SENTRY_DSN="" CAFEPAY_DISABLE_ANALYTICS=true
ENV CAFEPAY_LOCAL_RECOVERY=true CAFEPAY_MOCK_PAYMENTS=true
ENV VUE_APP_CAFEPAY_ADMIN_BASEURL=${API_ORIGIN}/
ENV VUE_APP_CAFEPAY_ADMIN_SOCKETURL=${SOCKET_ORIGIN}
ENV VUE_APP_CAFEPAY_LOCAL_RECOVERY=true
ENV VUE_APP_CAFEPAY_BASE_URL=${API_ORIGIN}/
ENV VUE_APP_CAFEPAY_SOCKET_URL=${SOCKET_ORIGIN}
ENV VUE_APP_SENTRY_KEY="" VUE_APP_I18N_LOCALE=fa-IR VUE_APP_I18N_FALLBACK_LOCALE=fa-IR
RUN npm run ${BUILD_SCRIPT}

FROM nginx:1.28-alpine
COPY cafepal/deploy/local/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
